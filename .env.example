# ========== AI 服务商配置 ==========

# AI 服务商: openai (MiniMax/DeepSeek/OpenAI等兼容接口) 或 claude
AI_PROVIDER=openai

# --- MiniMax 配置示例 (默认) ---
AI_API_KEY=your-minimax-api-key
AI_MODEL=MiniMax-M2.7
AI_BASE_URL=https://api.minimaxi.com/v1
# 海外用户使用: AI_BASE_URL=https://api.minimax.io/v1

# --- DeepSeek 配置示例 ---
# AI_API_KEY=your-deepseek-api-key
# AI_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com/v1

# --- Claude 配置示例 (需设 AI_PROVIDER=claude) ---
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ========== 服务配置 ==========

# Server port (optional, defaults to 8080)
PORT=8080

# Data directory for SQLite database (optional, defaults to ./data)
DATA_DIR=./data

# API Token (recommended for cloud deployment)
# If set, all /api/* requests require: Authorization: Bearer <token>
# Generate with: openssl rand -hex 32
# API_TOKEN=

# CORS allowed origin (optional, defaults to *)
# ALLOWED_ORIGIN=https://your-domain.com

# ========== 飞书集成 (可选) ==========
# 飞书集成通过 lark-cli (@larksuite/cli) 实现，无需在此配置
# 安装: npm install -g @larksuite/cli
# 认证: lark-cli config init && lark-cli auth login --recommend
# 验证: lark-cli auth status
