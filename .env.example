# Anthropic Claude API Key (required)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# AI Model (optional, defaults to claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Custom API Base URL (optional, for proxy or compatible APIs)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Server port (optional, defaults to 8080)
PORT=8080

# Data directory for SQLite database (optional, defaults to ./data)
DATA_DIR=./data

# API Token (recommended for cloud deployment)
# If set, all /api/* requests require: Authorization: Bearer <token>
# Generate with: openssl rand -hex 32
# API_TOKEN=

# CORS allowed origin (optional, defaults to *)
# ALLOWED_ORIGIN=https://your-domain.com
